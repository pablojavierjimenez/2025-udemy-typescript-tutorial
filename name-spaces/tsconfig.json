{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",              // Usar un módulo moderno (Parcel lo reescribirá al bundle)
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": false,        // RECOMENDADO por Parcel para la transpilación aislada.
    "skipLibCheck": true,           // Opcional: Acelera la compilación al saltarse la verificación de tipos en librerías
    "rootDir": "./src"              // Sugerencia: Especificar dónde están tus archivos fuente
  },
  "include": ["src/**/*"]           // Sugerencia: Asegurar que todos los archivos TS sean incluidos
}
